# Supabase credentials
SUPABASE_URL=https://jrrrwukcasaqyqaidrme.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Default device for API queries
DEFAULT_DEVICE_NAME=pi-garden-01

# Fallback collector read interval in seconds. Since migration 009 the
# source of truth is devices.collector_interval_seconds; this env var is
# used only when that column is absent or Supabase is unreachable. Default
# 30 matches pi-collector/config.yaml.
COLLECTOR_INTERVAL_SECONDS=30

# Alert engine background evaluation interval in seconds (default 60).
# The sidecar only evaluates while the desktop app is running.
ALERT_EVAL_INTERVAL_SECONDS=60

# IANA timezone used when devices.timezone is missing on insert/backfill.
# Falls back to the host machine's local zone, then Africa/Johannesburg.
DIRT_SIGNAL_DEFAULT_TZ=Africa/Johannesburg
